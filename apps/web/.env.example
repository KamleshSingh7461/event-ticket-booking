# ==========================================
# WYLDCARD STOREFRONT CONFIGURATION (EXAMPLE)
# ==========================================

# 1. Next.js Environment & Production URLs
NODE_ENV=production
NEXTAUTH_URL=https://your-storefront-domain.com
NEXT_PUBLIC_APP_URL=https://your-storefront-domain.com

# 2. NextAuth Configuration (Encryption Secret)
NEXTAUTH_SECRET=your_nextauth_secret_key

# 3. Database Connection
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/event-booking

# 4. Cloudinary Media Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. Email Server (SMTP) Configuration (Mandatory for sending tickets and invoices)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email_user@gmail.com
EMAIL_SERVER_PASSWORD=your_email_app_password
EMAIL_FROM=noreply@your-storefront-domain.com

# 6. PayU Payment Gateway Configuration
PAYU_ENV=test
PAYU_KEY=your_payu_key
PAYU_SALT=your_payu_salt
PAYU_PROD_URL=https://secure.payu.in/_payment
PAYU_TEST_URL=https://test.payu.in/_payment

# 7. Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
